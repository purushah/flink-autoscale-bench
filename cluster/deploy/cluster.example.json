{
  "testbed": "example",
  "namespace": "my-namespace",
  "brokers": "asbench-kafka.my-namespace.svc:9092",
  "operator_kafka_bootstrap": "asbench-kafka.my-namespace.svc:9092",
  "job_image": "registry.example/flink-autoscale-bench-job:cluster1",
  "job_service_account": "asbench-flink",
  "operator_deployment": "asbench-operator",
  "state_root": "file:///flink-data",
  "resources": {
    "jobManager": {"memory": "1280m", "cpu": 0.5},
    "taskManager": {"memory": "1024m", "cpu": 0.5}
  },
  "flink_conf": {
    "metrics.reporter.otel.factory.class": "org.apache.flink.metrics.otel.OpenTelemetryMetricReporterFactory",
    "metrics.reporter.otel.exporter.endpoint": "http://localhost:4317",
    "metrics.reporter.otel.exporter.protocol": "gRPC",
    "metrics.reporter.otel.interval": "10 SECONDS"
  },
  "pod_template": {
    "spec": {
      "containers": [{"name": "flink-main-container"}]
    }
  }
}
