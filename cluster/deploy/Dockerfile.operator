# Flink Kubernetes Operator 1.16.1 with the autoscaler plugin (the same jar as on the laptop) and the
# OpenTelemetry metric reporter, for the cluster test.
FROM apache/flink-kubernetes-operator:1.16.1
COPY --chown=flink:flink jev-autoscaler-plugin.jar /opt/flink/plugins/jev-autoscaler/jev-autoscaler-plugin.jar
COPY --chown=flink:flink flink-metrics-otel.jar /opt/flink/plugins/flink-metrics-otel/flink-metrics-otel.jar
