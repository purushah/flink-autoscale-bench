# The benchmark job for the cluster test, on the platform's newest Flink build (2.3, Java 17). That
# image already has the OpenTelemetry metric reporter and the S3 file system as plugins, so the job
# reports and checkpoints the way the platform's own jobs do.
FROM registry.example.com/flink/flink:2.3-java17
COPY --chown=9999:10952 bench-job.jar /opt/flink/usrlib/bench-job.jar
